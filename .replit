modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend Dev Server"

[[workflows.workflow]]
name = "Frontend Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && pnpm run develop"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8008
exposeLocalhost = true

[[ports]]
localPort = 32941
externalPort = 3000

[[ports]]
localPort = 34697
externalPort = 3002

[[ports]]
localPort = 35135
externalPort = 4200

[[ports]]
localPort = 36421
externalPort = 5173

[[ports]]
localPort = 36473
externalPort = 8000

[[ports]]
localPort = 38303
externalPort = 6800

[[ports]]
localPort = 38771
externalPort = 3003

[[ports]]
localPort = 40907
externalPort = 3001

[[ports]]
localPort = 42279
externalPort = 5000

[[ports]]
localPort = 45521
externalPort = 6000

[deployment]
deploymentTarget = "autoscale"
build = ["cd", "client", "&&", "pnpm", "run", "build"]
run = ["sh", "-c", "cd client && PORT=${PORT:-8000} pnpm run serve"]
