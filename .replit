modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend Dev Server"

[[workflows.workflow]]
name = "Frontend Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && pnpm run develop"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 32941
externalPort = 3000

[[ports]]
localPort = 40907
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
build = ["cd", "client", "&&", "pnpm", "run", "build"]
run = ["sh", "-c", "cd client && npx serve -l ${PORT:-8000} -c serve.json public"]
